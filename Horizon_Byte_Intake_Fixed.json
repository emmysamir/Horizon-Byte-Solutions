    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst f = item.json;\nconst errors = [];\nconst name = String(f['Full name'] || '').trim().replace(/\\s+/g, ' ');\nconst email = String(f.email || '').trim().toLowerCase();\nconst rawPosition = String(f.position || '').trim();\nconst positionMap = {\n  'ai automation engineer (junior)': 'Ai Automation Engineer (Junior)',\n  'data analyst': 'Data Analyst',\n  'customer support specialist': 'Customer Support Specialist'\n};\nconst position = positionMap[rawPosition.toLowerCase()] || rawPosition;\nconst motivation = String(f['why do you want this job?'] || '').trim();\nconst allowed = ['Ai Automation Engineer (Junior)', 'Data Analyst', 'Customer Support Specialist'];\nif (name.length < 3 || name.split(' ').length < 2 || !/^[\\p{L} .'-]+$/u.test(name)) errors.push('Please enter your full name (first and last name, letters only).');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) errors.push('Please enter a valid email address.');\nif (!allowed.includes(position)) errors.push('Please choose one of the listed positions.');\nif (motivation.length > 1500) errors.push('Please keep your motivation under 1500 characters.');\nif (!item.binary || !item.binary.cv) errors.push('Please attach your CV.');\nelse {\n const buf = await this.helpers.getBinaryDataBuffer(0, 'cv');\n if (buf.subarray(0,5).toString() !== '%PDF-') errors.push('Your CV must be a real PDF file.');\n if (buf.length > 5*1024*1024) errors.push('Your CV must be smaller than 5 MB.');\n if (buf.length < 500) errors.push('Your CV file looks empty or damaged.');\n}\nreturn [{json:{name,email,position,motivation,valid:errors.length===0,errors,errorText:errors.map(e=>'- '+e).join('\\n')},binary:item.binary}];"
      },
